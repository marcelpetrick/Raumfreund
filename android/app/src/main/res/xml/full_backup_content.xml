<!-- Android 6-11 counterpart of data_extraction_rules.xml. Redundant with
     android:allowBackup="false", but keeps the intent explicit: nothing of
     the app is backed up. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
